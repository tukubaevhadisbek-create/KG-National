# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git (он уже в .gitignore).

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Токен вашего Telegram-бота от @BotFather.
# Без него авторизация через Telegram Mini App работать не будет.
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenReplaceMe

# Если POSTGRES_DB не задан — используется SQLite (удобно для разработки).
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Домен(ы) frontend'а, через запятую, без слэша на конце.
# Например: https://your-frontend.example.com
CORS_ALLOWED_ORIGINS=
